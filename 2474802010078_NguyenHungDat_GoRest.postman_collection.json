      "name": "Positive_Cases",
      "item": [
        {
          "name": "POST Create User 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "var postData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"User has an ID\", function () {\r",
                  "    pm.expect(postData.id).to.exist;\r",
                  "});\r",
                  "\r",
                  "if (postData.id) {\r",
                  "    pm.environment.set(\"userId\", String(postData.id));\r",
                  "}\r",
                  "\r",
                  "console.log(\"Saved userId:\", postData.id);\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "0dbc40845fe039d81d243da83f21094131fdf5c466ce4f199e484d53d91bb18e",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
