              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Nguyen Van An\",\r\n  \"gender\": \"male\",\r\n  \"email\":\"{{$randomEmail}}\",\r\n  \"status\": \"active\"\r\n}",
              "options": {
